<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_purple_pink"
    android:orientation="vertical">

    <!-- 帖子信息 + 回复列表（统一 RecyclerView，头部为帖子信息，后续为回复条目） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- 底部回复输入栏（固定在底部，键盘弹出时在其上方） -->
    <LinearLayout
        android:id="@+id/reply_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@drawable/bg_card_acrylic"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <EditText
            android:id="@+id/et_reply_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="写回复…"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp"
            android:background="@drawable/bg_glass_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <TextView
            android:id="@+id/btn_send_reply"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="发送"
            android:textSize="15sp"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/bg_glass_button"
            android:backgroundTint="@color/accent_blue_purple"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

</LinearLayout>
